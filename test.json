{
  "steps": [
    {
      "group": ":pytest: Tests",
      "key": "tests",
      "steps": [
        {
          "label": ":pytest: Py {{matrix.python}}",
          "command": "export DEBIAN_FRONTEND=noninteractive && apt-get update -qq && apt-get install -yqq nodejs npm tzdata\nexport PIP_EXTRA_INDEX_URL=\"https://buildkite:$${PACKAGE_REGISTRY_TOKEN}@packages.buildkite.com/david-trowbridge/python/pypi/simple\"\npip install --upgrade pip\npip install tox\ntox -e \"py$(printf '%s' '{{matrix.python}}' | tr -d .)\"",
          "secrets": [
            "PACKAGE_REGISTRY_TOKEN"
          ],
          "matrix": {
            "setup": {
              "python": [
                "3.10",
                "3.11",
                "3.12",
                "3.13",
                "3.14"
              ]
            }
          },
          "plugins": [
            {
              "docker#v5.13.0": {
                "image": "python:{{matrix.python}}",
                "environment": [
                  "PACKAGE_REGISTRY_TOKEN"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "label": ":package: Build wheel",
      "key": "build-wheel",
      "depends_on": "tests",
      "command": "export DEBIAN_FRONTEND=noninteractive && apt-get update -qq && apt-get install -yqq nodejs npm tzdata\nexport PIP_EXTRA_INDEX_URL=\"https://buildkite:$${PACKAGE_REGISTRY_TOKEN}@packages.buildkite.com/david-trowbridge/python/pypi/simple\"\npip install --upgrade pip\npip install build\npython -m build --wheel",
      "secrets": [
        "PACKAGE_REGISTRY_TOKEN"
      ],
      "artifact_paths": "dist/*.whl",
      "plugins": [
        {
          "docker#v5.13.0": {
            "image": "python:3.10",
            "environment": [
              "PACKAGE_REGISTRY_TOKEN"
            ]
          },
          "generate-provenance-attestation#v1.0.0": {
            "artifacts": "*.whl",
            "attestation_name": "build.attestation.json"
          }
        }
      ]
    },
    {
      "label": ":wastebasket: Delete existing dev package",
      "key": "delete-old-package",
      "depends_on": "build-wheel",
      "plugins": [
        {
          "https://github.com/davidt/package-delete-buildkite-plugin.git": {
            "artifacts": "*.whl",
            "registry": "david-trowbridge/python"
          }
        }
      ]
    },
    {
      "label": ":buildkite: Publish package",
      "depends_on": "delete-old-package",
      "plugins": [
        {
          "publish-to-packages#v2.2.0": {
            "artifacts": "*.whl",
            "registry": "david-trowbridge/python",
            "attestations": "build.attestation.json"
          }
        }
      ]
    }
  ]
}